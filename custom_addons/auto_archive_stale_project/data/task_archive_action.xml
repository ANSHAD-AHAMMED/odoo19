<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cron_task_archieve_project" model="ir.cron">
        <field name="name">archive stale task</field>
        <field name="model_id" ref="auto_archive_stale_project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.archive_project()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1))"/>
    </record>
</odoo>
