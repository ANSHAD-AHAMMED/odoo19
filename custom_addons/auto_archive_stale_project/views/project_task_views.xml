<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="associated_product_inherited_model_view_form" model="ir.ui.view">
        <field name="name">project.task.form.inherit.project.task</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="hr_timesheet.project_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="task_id" string="Stage" domain="[('id', 'in', project_task_ids)]"/>
            </xpath>
        </field>
    </record>
</odoo>