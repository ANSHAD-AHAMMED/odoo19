<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="clear_button" inherit_id="website_sale.cart_lines" name="Top Selling Products Section">

        <xpath expr="//div[@class='d-none d-md-block']" position="after">
            <a
                href='#'
                class="js_delete_product small fa fa-trash"
                aria-label="Remove from cart"
                title="Remove from cart"
            />
        </xpath>

        <xpath expr="//div[@id='suggested_products']" position="after">
            <a role="button" class="btn btn-primary" href="/shop/cart/clear_cart">
                Clear Cart
            </a>
        </xpath>
    </template>
</odoo>
