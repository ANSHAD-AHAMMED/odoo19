<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No offers added yet</p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_hospital_appointment" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_datetime"/>
                <field name="consultation_fee"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="schedule_appointment" type="object" string="Schedule" class="oe_highlight"
                            title="Mark as Schedule"
                    />
                    <button name="start_consultation" type="object" string="Start Consultation" class="oe_highlight"
                            title="Mark as Start Consultation"
                    />
                    <button name="complete_consultation" type="object" string="Complete Consultation" class="oe_highlight"
                            title="Mark as Complete Consultation"
                    />
                    <button name="delete_appointment" type="object" string="Cancel" class="oe_highlight"
                            title="Mark as Cancel" invisible="state in ['completed']"
                    />
<!--                    invisible="state in ['check_out','returned','over_due','cancel']"-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="department_id"/>
                            <field name="doctor_id" domain="[('id', 'in', doctor_ids)]"/>
                            <field name="appointment_datetime" required="1"/>
                        </group>
                        <group>
                            <field name="consultation_fee"/>
                            <field name="symptoms"/>
                            <field name="diagnosis"/>
                            <field name="medicine_total"/>
                            <field name="total_bill"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="prescription">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="appointment_id"/>
                                    <field name="product_id"/>
                                    <field name="dosage"/>
                                    <field name="days"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="seq_hospital_appointments" model="ir.sequence">
        <field name="name">Hospital Appointment</field>
        <field name="code">hospital.appointment</field>
        <field name="prefix">AP</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>