<odoo>
    <data>
        <record id="hr_employee_view_form_inherit_doctor" model="ir.ui.view">
            <field name="name">hr.employee.view.form.start.date</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//h5/field[@name='category_ids']" position="after">
                    <group>
                        <field name="is_doctor"/>
                        <field name="specialization"/>
                        <field name="is_available"/>
                        <field name="treatment_progress"/>
                    </group>

                </xpath>

            </field>
        </record>
    </data>
</odoo>