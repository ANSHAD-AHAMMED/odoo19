<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Action -->
    <record id="action_mrp_production_line" model="ir.actions.act_window">
        <field name="name">mrp.production.material.line</field>
        <field name="res_model">mrp.production.material.line</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No offers added yet</p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_production_ext_list" model="ir.ui.view">
        <field name="name">mrp.production.material.line.list</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="required_qty"/>
                <field name="available_qty"/>
                <field name="consumed_qty"/>
            </list>
        </field>
    </record>

</odoo>