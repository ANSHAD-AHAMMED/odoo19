<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Action -->
    <record id="action_mrp_production" model="ir.actions.act_window">
        <field name="name">mrp production</field>
        <field name="res_model">mrp.production.ext</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No offers added yet</p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">mrp.production.ext.list</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="bom_id"/>
                <field name="quantity"/>
                <field name="planned_date"/>
                <!--                <field name="planned_date"/>-->
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">mrp.production.ext.form</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           status_visible="coming_soon,available,unavailable,"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                            <field name="quantity"/>
                            <field name="planned_date"/>
                            <field name="is_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Part">
                            <field name="material_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="required_qty"/>
                                    <field name="available_qty"/>
                                    <field name="consumed_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="seq_library_book" model="ir.sequence">
        <field name="name">mrp production reference</field>
        <field name="code">mrp.production.ext</field>
        <field name="prefix">MRP</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>