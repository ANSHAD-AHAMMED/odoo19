<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">country.pricelist.list</field>
        <field name="model">country.pricelist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
                <field name="pricelist_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">country.pricelist.form</field>
        <field name="model">country.pricelist</field>
        <field name="arch" type="xml">
            <form>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="pricelist_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_country_price_list" model="ir.actions.act_window">
        <field name="name">Country pricelist</field>
        <field name="res_model">country.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No country pricelist added yet</p>
        </field>
    </record>

</odoo>