<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_simple_production_bom_list" model="ir.ui.view">
        <field name="name">simple.product.bom.list</field>
        <field name="model">simple.product.bom</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_simple_production_bom_form" model="ir.ui.view">
        <field name="name">simple.product.bom.form</field>
        <field name="model">simple.product.bom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="bom_component_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="simple_product_bom_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_simple_production_bom" model="ir.actions.act_window">
        <field name="name">Simple Production BOM</field>
        <field name="res_model">simple.product.bom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your simple product BOM here</p>
        </field>
    </record>

</odoo>


