<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_simple_production_list" model="ir.ui.view">
        <field name="name">simple.production.list</field>
        <field name="model">simple.production</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_simple_production_form" model="ir.ui.view">
        <field name="name">simple.production.form</field>
        <field name="model">simple.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="update_stock" type="object" string="Create product" class="oe_highlight"
                            title="Create product"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="product_qty"/>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="component_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="simple_product_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_simple_production" model="ir.actions.act_window">
        <field name="name">Simple Production</field>
        <field name="res_model">simple.production</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your product here</p>
        </field>
    </record>

</odoo>


