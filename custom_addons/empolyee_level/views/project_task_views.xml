<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_timesheet_inherited_model_view_form" model="ir.ui.view">
        <field name="name">project.task.form.inherit.project.task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="employee hours">
                    <group>
                        <field name="allowed_hours"/>
                    <field name="total_logged_hours"/>
                    <field name="over_budget"/>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>