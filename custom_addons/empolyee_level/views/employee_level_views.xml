<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_employee_level_list" model="ir.ui.view">
        <field name="name">employee.level.list</field>
        <field name="model">employee.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="level"/>
                <field name="salary"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_level" model="ir.actions.act_window">
        <field name="name">Employee Level</field>
        <field name="res_model">employee.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your product here</p>
        </field>
    </record>

</odoo>


