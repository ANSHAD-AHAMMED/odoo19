<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_rating.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-img')]" position="inside">

                <div class="col p-1">
                    <t t-foreach="props.product.product_rating" t-as="star" t-key="star_rating">
                        <t t-if="star==5">
                            <span>⭐⭐⭐⭐⭐</span>
                        </t>

                        <t t-if="star==4">
                            <span>⭐⭐⭐⭐</span>
                        </t>

                        <t t-if="star==3">
                            <span>⭐⭐⭐</span>
                        </t>

                        <t t-if="star==2">
                            <span>⭐⭐</span>
                        </t>

                        <t t-if="star==1">
                            <span>⭐</span>
                        </t>
                    </t>

            </div>

        </xpath>
    </t>
</templates>
