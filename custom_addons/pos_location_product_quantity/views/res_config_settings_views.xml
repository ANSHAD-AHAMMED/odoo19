<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.pos_location_product_quantity.product_in_location
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting string="Product in location"
                         help="product in location"
                         id="product_in_location-settings">
                    <field name="product_in_location"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
