<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_inherited_model_view_form_quiz_timer" model="ir.ui.view">
        <field name="name">survey.survey.form.inherit.survey.survey</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='participants']" position="inside">
                <field name="timer" string="Idle Timer (Seconds)" widget="mrp_timer"/>
            </xpath>
        </field>
    </record>
</odoo>
