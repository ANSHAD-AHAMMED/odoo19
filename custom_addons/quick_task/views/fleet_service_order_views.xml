<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Action -->
    <record id="action_fleet_service_order" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">fleet.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No offers added yet</p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">fleet.service.order.list</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="technician_id"/>
                <field name="service_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">fleet.service.order.form</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           status_visible="coming_soon,available,unavailable,"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="technician_id"/>
                            <field name="service_date"/>
                            <field name="state"/>
                            <field name="parts_total"/>
                            <field name="labour_cost"/>
                            <field name="grand_total"/>
                            <field name="check_list_progress"/>
                            <field name="type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Part">
                            <field name="part_ids">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>

                        <page string="Checklist">
                            <field name="checklist_ids">
                                <list editable="bottom">
                                    <field name="task_name"/>
                                    <field name="is_done"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="seq_library_book" model="ir.sequence">
        <field name="name">Library Book reference</field>
        <field name="code">fleet.service.order</field>
        <field name="prefix">FL</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>