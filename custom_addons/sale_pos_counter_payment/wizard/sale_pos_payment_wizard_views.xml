<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Counter Payment Wizard — Form View
         ============================================================ -->
    <record id="view_sale_pos_payment_wizard_form" model="ir.ui.view">
        <field name="name">sale.pos.payment.wizard.form</field>
        <field name="model">sale.pos.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay at the Counter">

                <!-- ── Header info banner ──────────────────────────── -->
                <div class="alert alert-info mb-3" role="status">
                    <i class="fa fa-shopping-cart me-2"/>
                    Collecting payment for
                    <strong>
                        <field name="sale_order_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                    </strong>
                    via POS session
                    <strong>
                        <field name="pos_session_id" readonly="1" nolabel="1" options="{'no_open': True}"/>
                    </strong>
                </div>

                <field name="currency_id" invisible="1"/>

                <!-- ── Payment lines ────────────────────────────────── -->
                <field name="payment_line_ids" nolabel="1">
                    <list string="Payment Methods" editable="bottom">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="payment_method_id" readonly="1"/>
                        <field name="amount" sum="Total Paid"/>
                    </list>
                </field>

                <!-- ── Summary totals ───────────────────────────────── -->
                <group col="2" class="mt-3">
                    <group>
                        <field name="total_amount" readonly="1"
                               widget="monetary"
                               string="Order Total"/>
                    </group>
                    <group>
                        <field name="paid_amount" readonly="1"
                               widget="monetary"
                               string="Paid Amount"/>
                        <field name="remaining_amount" readonly="1"
                               widget="monetary"
                               string="Remaining"
                               decoration-danger="remaining_amount > 0"
                               decoration-success="remaining_amount &lt;= 0"/>
                    </group>
                </group>

                <!-- ── Footer buttons ───────────────────────────────── -->
                <footer>
                    <button name="action_confirm_payment"
                            string="Confirm Payment"
                            type="object"
                            class="btn-primary"
                            data-hotkey="v"/>
                    <button string="Discard"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
